+	/**
+	 * Opt-in linear HDR radiance for a caller-owned floating point sky target.
+	 * Ordinary dimension skies retain their original color and blending. The caller
+	 * owns exposure and tone mapping; radianceScale is independent of visibility.
+	 */
+	public boolean renderLinear(ClientLevel level, Camera camera, float partialTicks,
+			Matrix4f modelView, Matrix4f projection, float brightness,
+			float convergence, Vector3f convergenceForward, float radianceScale)
+	{
+		if(!Float.isFinite(radianceScale) || radianceScale <= 0.0F)
+			throw new IllegalArgumentException("radianceScale must be finite and positive");
+		var shaders = new net.povstalec.stellarview.client.render.shader.CelestialShaderInstance[] {
+				StellarViewShaders.starShader(), StellarViewShaders.instancedStarShader(),
+				StellarViewShaders.starTexShader(), StellarViewShaders.instancedStarTexShader()};
+		int first = GeneralConfig.textured_stars.get() ? 2 : 0;
+		for(int i = first; i < first + 2; i++)
+			if(shaders[i] == null || shaders[i].EXTERNAL_RADIANCE == null
+					|| shaders[i].getUniform("ExternalViewport") == null) return false;
+		int[] viewport = new int[4];
+		org.lwjgl.opengl.GL11.glGetIntegerv(org.lwjgl.opengl.GL11.GL_VIEWPORT, viewport);
+		float[] previous = new float[shaders.length];
+		float[] previousViewport = new float[shaders.length * 2];
+		try
+		{
+			for(int i = 0; i < shaders.length; i++)
+				if(shaders[i] != null && shaders[i].EXTERNAL_RADIANCE != null)
+				{
+					previous[i] = shaders[i].EXTERNAL_RADIANCE.getFloatBuffer().get(0);
+					shaders[i].EXTERNAL_RADIANCE.set(radianceScale);
+					var dimensions = shaders[i].getUniform("ExternalViewport");
+					if(dimensions != null) {
+						previousViewport[2*i] = dimensions.getFloatBuffer().get(0);
+						previousViewport[2*i+1] = dimensions.getFloatBuffer().get(1);
+						dimensions.set((float) viewport[2], (float) viewport[3]);
+					}
+				}
+			return render(level, camera, partialTicks, modelView, projection, brightness,
+					convergence, convergenceForward);
+		}
+		finally
+		{
+			for(int i = 0; i < shaders.length; i++)
+				if(shaders[i] != null && shaders[i].EXTERNAL_RADIANCE != null)
+				{
+					shaders[i].EXTERNAL_RADIANCE.set(previous[i]);
+					var dimensions = shaders[i].getUniform("ExternalViewport");
+					if(dimensions != null) dimensions.set(previousViewport[2*i],previousViewport[2*i+1]);
+				}
+		}
+	}
