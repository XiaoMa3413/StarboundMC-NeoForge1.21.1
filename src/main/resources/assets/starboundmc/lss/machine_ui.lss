// Shared LDLib2 language for ship machinery. The individual screens compose
// these primitives instead of painting fixed pixel rectangles in renderBg.
.machine-screen {
  background: sdf(#b8050911, 0);
}

.machine-shell {
  background: sdf(#f20b141e, 5, 1, #365d6a);
  overflow-clip: true;
}

.machine-header {
  background: sdf(#f010202c, 5, 1, #294957);
}

.machine-signal {
  background: sdf(#63e2df, 2);
}

.machine-title {
  font-size: 9;
  text-color: #eafaff;
  text-shadow: true;
}

.machine-subtitle {
  font-size: 6;
  text-color: #7194a4;
  text-shadow: false;
}

.machine-key-hint {
  background: sdf(#142731, 4, 1, #345d6a);
  font-size: 6;
  text-color: #91aeb9;
  text-shadow: false;
}

.machine-content {
  background: sdf(#09121b, 0);
}

.machine-section {
  background: sdf(#c80e1b25, 3, 1, #233f4b);
}

.machine-section-title {
  font-size: 7;
  text-color: #b9dce5;
  text-shadow: false;
}

.machine-status {
  font-size: 6;
  text-color: #62d5d4;
  text-shadow: false;
}

.machine-description {
  font-size: 6;
  text-color: #6f8b98;
  text-shadow: false;
  text-wrap: wrap;
}

.machine-field-label {
  font-size: 6;
  text-color: #90aab5;
  text-shadow: false;
}

.machine-button:host {
  base-background: sdf(#182a35, 3, 1, #315462);
  hover-background: sdf(#21414c, 3, 1, #63e2df);
  pressed-background: sdf(#10242d, 3, 1, #4bb7bd);
  focus-overlay: sdf(#00000000, 3, 1, #8cf5f2);
}

.machine-button .__button_text__ {
  font-size: 7;
  text-color: #d9edf2;
  text-shadow: false;
}

.machine-button-primary:host {
  base-background: sdf(#17434b, 3, 1, #4c9ba2);
  hover-background: sdf(#23606a, 3, 1, #8cf5f2);
  pressed-background: sdf(#102f35, 3, 1, #63e2df);
}

.teleporter-destination:host {
  base-background: sdf(#101e28, 3, 1, #223f4b);
  hover-background: sdf(#183641, 3, 1, #5bcbd0);
  pressed-background: sdf(#0c2028, 3, 1, #3e9da4);
  padding-horizontal: 5;
}

.teleporter-destination-type {
  background: sdf(#152d38, 2, 1, #315562);
  font-size: 5;
  text-color: #75c8cf;
  text-shadow: false;
}

.teleporter-destination-name {
  font-size: 7;
  text-color: #c9e0e7;
  text-shadow: false;
}

.teleporter-name-field:host {
  background: sdf(#071119, 3, 1, #31515d);
  focus-overlay: sdf(#00000000, 3, 1, #63e2df);
  padding-horizontal: 4;
}

.machine-online {
  font-size: 6;
  text-color: #60d394;
  text-shadow: false;
}

.machine-empty-state {
  font-size: 7;
  text-color: #647d88;
  text-shadow: false;
}

.teleporter-destination-list .__scroller_view_vertical-scroller__ {
  width: 5;
  margin-left: 4;
}

.teleporter-destination-list .__scroller_scroll_container__ {
  background: sdf(#09141d, 2);
  padding-all: 1;
}

.teleporter-destination-list .__scroller_scroll_bar__ {
  base-background: sdf(#315562, 2);
  hover-background: sdf(#4c8991, 2);
  pressed-background: sdf(#63e2df, 2);
}

// Teleporter-only monochrome console: black surfaces, thin pale-grey framing,
// and semantic destination thumbnails. Other machine screens do not inherit it.
.teleporter-shell {
  background: sdf(#f2060708, 2, 1, #a3a6a8);
}

.teleporter-shell .machine-header {
  background: sdf(#f0090a0b, 2, 1, #65686a);
}

.teleporter-header-mark {
  background: sdf(#c8cbcc, 1);
}

.teleporter-shell .machine-title {
  font-size: 8;
  text-color: #eceeed;
  text-shadow: false;
}

.teleporter-shell .machine-key-hint {
  background: sdf(#0d0e0f, 1, 1, #5c6062);
  font-size: 6;
  text-color: #bfc2c3;
}

.teleporter-shell .machine-content {
  background: sdf(#050607, 0);
}

.teleporter-shell .machine-section {
  background: sdf(#ed090a0b, 1, 1, #55595b);
}

.teleporter-shell .teleporter-rename-section {
  background: sdf(#f00b0c0d, 1, 1, #65696b);
}

.teleporter-section-tab {
  background: sdf(#111315, 1, 0, #00000000);
}

.teleporter-shell .machine-section-title {
  font-size: 6;
  text-color: #d8dad9;
}

.teleporter-network-lamp {
  background: sdf(#c8cbcc, 1, 1, #3c3f41);
}

.teleporter-shell .machine-status {
  font-size: 6;
  text-color: #aeb1b2;
}

.teleporter-shell .machine-field-label {
  text-color: #afb2b3;
}

.teleporter-field-caption {
  background: sdf(#111315, 1, 0, #00000000);
  padding-left: 3;
}

.teleporter-shell .machine-online {
  text-color: #bfc2c3;
}

.teleporter-shell .machine-empty-state {
  text-color: #777b7d;
}

.teleporter-shell .machine-button:host {
  base-background: sdf(#0e1011, 1, 1, #626668);
  hover-background: sdf(#1b1e20, 1, 1, #c3c7c8);
  pressed-background: sdf(#050607, 1, 1, #f0f1f1);
  focus-overlay: sdf(#00000000, 1, 1, #d9dcdd);
}

.teleporter-shell .machine-button .__button_text__ {
  text-color: #e2e4e4;
}

.teleporter-shell .machine-button-primary:host {
  base-background: sdf(#202325, 1, 1, #8d9294);
  hover-background: sdf(#35393b, 1, 1, #e0e2e2);
  pressed-background: sdf(#101213, 1, 1, #f4f5f5);
}

.teleporter-shell .teleporter-destination:host {
  base-background: sdf(#08090a, 1, 1, #3f4345);
  hover-background: sdf(#151719, 1, 1, #aeb2b4);
  pressed-background: sdf(#030404, 1, 1, #e3e5e5);
  padding-horizontal: 4;
}

.teleporter-destination-icon {
  background: sdf(#030404, 2, 1, #676b6d);
}

.teleporter-shell .teleporter-destination-type {
  font-size: 5;
  text-color: #85898b;
  text-shadow: false;
}

.teleporter-shell .teleporter-destination-name {
  text-color: #e4e6e5;
}

.teleporter-route-arrow {
  font-size: 6;
  text-color: #aeb2b3;
  text-shadow: false;
}

.teleporter-icon-glyph {
  background: sdf(#c9cccd, 0);
}

.teleporter-icon-ship-nose {
  background: sdf(#edf0ef, 1);
}

.teleporter-icon-ship-body {
  background: sdf(#c9cccd, 1);
}

.teleporter-icon-ship-wing-left {
  background: sdf(#aeb2b3, 1);
}

.teleporter-icon-ship-wing-right {
  background: sdf(#aeb2b3, 1);
}

.teleporter-icon-ship-tail {
  background: sdf(#7f8486, 1);
}

.teleporter-icon-flag-top {
  background: sdf(#e3e5e5, 0);
}

.teleporter-icon-flag-middle {
  background: sdf(#c3c6c7, 0);
}

.teleporter-icon-flag-tip {
  background: sdf(#9da1a3, 0);
}

.teleporter-shell .teleporter-name-field:host {
  background: sdf(#030405, 1, 1, #666a6c);
  focus-overlay: sdf(#00000000, 1, 1, #daddde);
}

.teleporter-shell .teleporter-destination-list .__scroller_scroll_container__ {
  background: sdf(#050607, 1, 1, #303335);
}

.teleporter-shell .teleporter-destination-list .__scroller_scroll_bar__ {
  base-background: sdf(#5d6163, 1);
  hover-background: sdf(#9da1a3, 1);
  pressed-background: sdf(#d9dbdc, 1);
}
