/* Approved N.O.V.A. terminal: graphite equipment, cyan interaction, flat reading surfaces.
   Button surfaces and 1px edge relief are drawn by NovaTerminalButton. */
.ship-ai-screen { background: rect(#b8020507); }
.command-shell { background: group(rect(#ff0b151d), border(-1, #344b55)); }
.command-header { background: rect(#162630); }
.command-body { background: rect(#0b151d); }
.command-brand { font-size: 9; text-color: #d8edf0; text-shadow: false; }
.command-title { font-size: 10; text-color: #e5f3f5; text-shadow: false; }
.command-context-title { font-size: 7; text-color: #b6ced5; text-shadow: false; }
.command-copy, .ship-ai-reply-text { font-size: 8; text-color: #d8edf0; text-shadow: false; text-wrap: wrap; }
.command-muted { font-size: 7; text-color: #95aeb9; text-shadow: false; text-wrap: wrap; }
.command-accent { font-size: 8; text-color: #63d8d4; text-shadow: false; }
.command-section { font-size: 7; text-color: #85a5b0; text-shadow: false; margin-top: 3; }
.command-task-state { font-size: 7; text-color: #95aeb9; text-shadow: false; }
.command-button .__button_text__ { font-size: 8; text-color: #d8edf0; text-shadow: false; text-wrap: wrap; }
.command-nav-button .__button_text__ { font-size: 8; text-color: #85a5b0; }
.command-nav-button.command-selected .__button_text__ { text-color: #e5f3f5; }
.command-filter .__button_text__ { font-size: 7; }
.command-link .__button_text__ { font-size: 7; text-color: #b6d5dc; }
.command-selected .__button_text__ { text-color: #e5f3f5; }
.command-button:disabled .__button_text__ { text-color: #718791; }
.command-button:hover .__button_text__ { text-color: #e5f3f5; }
.command-button:disabled:hover .__button_text__ { text-color: #718791; }
.command-scroll .__scroller_view_vertical-scroller__ { width: 3; margin-left: 4; }
.command-scroll .__scroller_scroll_container__ { background: rect(#172c35); }
.command-scroll .__scroller_scroll_bar__ { base-background: rect(#526975); hover-background: rect(#63d8d4); pressed-background: rect(#d8edf0); }
.ship-ai-history-text { font-size: 8; text-color: #d8edf0; text-shadow: false; text-wrap: wrap; }
.ship-ai-message-speaker { font-size: 7; text-color: #63d8d4; text-shadow: false; }
.ship-ai-portrait-state { font-size: 7; text-color: #95b7c0; text-shadow: false; }
.ship-ai-option-hint { font-size: 7; text-color: #95aeb9; text-shadow: false; text-wrap: wrap; }
.ship-ai-topic-button .__button_text__ { font-size: 7; }
.command-complete { text-color: #83e3a2; }
.command-cost { font-size: 7; text-color: #e2b66f; text-shadow: false; }
.command-fault { text-color: #e46b72; }
