// Slot-backed ship machinery. Vanilla keeps ownership of every Slot; these
// LDLib2 elements provide the panel, labels, controls and non-interactive sockets.

.machine-inventory-screen {
  background: rect(#9906090c);
}

.inventory-machine-shell {
  overflow-clip: true;
}

.machine-inventory-title,
.crate-title {
  font-size: 8;
  text-color: #d8edf0;
  text-shadow: false;
}

.machine-inventory-caption {
  font-size: 6;
  text-color: #8aa2ad;
  text-shadow: false;
}

.machine-slot-socket {
  background: rect(#081116);
}

.player-slot-socket {
  background: rect(#081116);
}

.hotbar-slot-socket {
  background: rect(#0d171f);
}

// Fuel: amber energy. Cyan is reserved for digital processing and navigation.
.fuel-controller-shell {
  background: rect(#101a22);
}

.fuel-controller-shell .machine-inventory-header {
  background: rect(#16232d);
}

.fuel-header-rail {
  background: #d59b4a;
}

.fuel-header-status {
  font-size: 5;
  text-color: #8aa2ad;
  text-shadow: false;
}

.fuel-console {
  background: rect(#0d171f);
}

.fuel-gauge-caption {
  font-size: 5;
  text-color: #8d999e;
  text-shadow: false;
}

.fuel-gauge {
  background: group(rect(#070a0c), border(-1, #68757a));
}

.fuel-gauge-fill {
  background: rect(#b18546);
}

.fuel-gauge-low .fuel-gauge-fill {
  background: rect(#966537);
}

.fuel-gauge-full .fuel-gauge-fill {
  background: rect(#c39755);
}

.fuel-gauge-tick {
  background: #70484f53;
}

.fuel-gauge-label {
  font-size: 5;
  text-color: #f0f3f3;
  text-shadow: true;
}

.fuel-slot-socket {
  background: rect(#081116);
}

.fuel-refuel-button:host {
  base-background: rect(#624a2c);
  hover-background: rect(#7d5e36);
  pressed-background: rect(#42321f);
}

.fuel-refuel-button .__button_text__ {
  font-size: 6;
  text-color: #e9efef;
  text-shadow: false;
}

.fuel-refuel-button.__disabled__:host {
  base-background: group(rect(#1c2225), border(-1, #424b4f));
  hover-background: group(rect(#1c2225), border(-1, #424b4f));
  pressed-background: group(rect(#1c2225), border(-1, #424b4f));
}

.fuel-refuel-button.__disabled__ .__button_text__ {
  text-color: #718791;
}

.fuel-cost-label {
  font-size: 5;
  text-color: #8e999d;
  text-shadow: false;
}

.fuel-inventory-section {
  background: rect(#101a22);
}

// Cargo: neutral graphite. Contents carry the colour, not the storage grid.
.ship-crate-shell {
  background: rect(#101a22);
}

.crate-header {
  background: rect(#16232d);
}

.crate-header-index {
  background: #8aa2ad;
}

.crate-capacity {
  font-size: 5;
  text-color: #8aa2ad;
  text-shadow: false;
}

.crate-cargo-section {
  background: rect(#0d171f);
}

.cargo-slot-socket {
  background: rect(#081116);
}

.crate-inventory-section {
  background: rect(#101a22);
}

// Refinery: cyan processing, restrained green only when output can be claimed.
.voxel-refinery-shell {
  background: rect(#101a22);
}

.voxel-machine-header {
  background: rect(#16232d);
}

.voxel-refinery-rail {
  background: #4fc8cf;
}

.voxel-machine-header-status {
  font-size: 5;
  text-color: #8aa2ad;
  text-shadow: false;
}

.voxel-refinery-process {
  background: rect(#0d171f);
}

.voxel-inventory-section {
  background: rect(#101a22);
}

.voxel-machine-caption {
  font-size: 5;
  text-color: #8fa7af;
  text-shadow: false;
}

.voxel-refinery-input-socket {
  background: rect(#081116);
}

.voxel-refinery-arrow {
  background: group(rect(#071014), border(-1, #2f555f));
  overflow-clip: true;
}

.voxel-refinery-arrow-fill {
  background: #4fc8cf;
}

.voxel-refinery-arrow-glyph {
  font-size: 7;
  text-color: #9ee9e9;
  text-shadow: false;
}

.voxel-refinery-status {
  font-size: 5;
  text-color: #8cb9c1;
  text-shadow: false;
}

.voxel-refinery-wallet {
  font-size: 5;
  text-color: #8aa2ad;
  text-shadow: false;
}

.voxel-refinery-claim:host {
  base-background: group(rect(#202126), border(-1, #5f6669));
  hover-background: group(rect(#2a3032), border(-1, #a9b7b7));
  pressed-background: group(rect(#15191b), border(-1, #d7e2e1));
}

.voxel-refinery-claim.voxel-output-ready:host {
  base-background: rect(#26483d);
  hover-background: rect(#345e4f);
  pressed-background: rect(#1a3029);
}

.voxel-refinery-claim.__disabled__:host,
.voxel-refinery-claim.voxel-output-running:host {
  base-background: group(rect(#171b1d), border(-1, #3b4548));
  hover-background: group(rect(#171b1d), border(-1, #3b4548));
  pressed-background: group(rect(#171b1d), border(-1, #3b4548));
}

.voxel-refinery-output-amount {
  font-size: 6;
  text-color: #d8edf0;
  text-shadow: true;
}

.voxel-refinery-claim.__disabled__ .voxel-refinery-output-amount {
  text-color: #718791;
  text-shadow: false;
}

.voxel-machine-action:host {
  base-background: rect(#20545d);
  hover-background: rect(#2c6b73);
  pressed-background: rect(#163e46);
}

.voxel-machine-action .__button_text__ {
  font-size: 6;
  text-color: #e7eeee;
  text-shadow: false;
}

.voxel-machine-action.voxel-refinery-stop:host {
  base-background: group(rect(#3a2921), border(-1, #9b7057));
  hover-background: group(rect(#57372a), border(-1, #e6a576));
  pressed-background: group(rect(#291b17), border(-1, #ffd0a8));
}

.voxel-machine-action.voxel-refinery-stop .__button_text__ {
  text-color: #ffd8b8;
}

.voxel-machine-action.__disabled__:host {
  base-background: group(rect(#1a2022), border(-1, #424d50));
  hover-background: group(rect(#1a2022), border(-1, #424d50));
  pressed-background: group(rect(#1a2022), border(-1, #424d50));
}

.voxel-machine-action.__disabled__ .__button_text__ {
  text-color: #718791;
}


// Alloy furnace: compact slot geometry, distinct heat and process channels.
.alloy-shell { background: rect(#101a22); }
.alloy-process { background: rect(#0d171f); }
.alloy-title { font-size: 7; text-color: #d8edf0; text-shadow: false; }
.alloy-status { font-size: 6; text-color: #8aa2ad; text-shadow: false; }
