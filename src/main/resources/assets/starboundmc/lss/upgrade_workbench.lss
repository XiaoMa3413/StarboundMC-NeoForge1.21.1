// Matter Manipulator workbench: graphite ship console framing a restrained green engineering viewport.

.upgrade-screen { background: rect(#A605080A); }

.upgrade-shell {
  background: group(rect(#081015), border(-1, #304852));
  overflow-clip: true;
}

// Green belongs to the engineering display, not the entire machine shell.
.upgrade-blueprint-sheet {
  background: group(rect(#06120D), border(-1, #294D38));
}

.upgrade-header {
  background: group(rect(#0B151D), border(-1, #304852));
}

.upgrade-header-rail { background: #83E3A2; }

.upgrade-title { font-size: 6; text-color: #D8EDF0; text-shadow: false; }
.upgrade-header-hint { font-size: 5; text-color: #78959B; text-shadow: false; }
.upgrade-module-count { font-size: 5; text-color: #B8F47A; text-shadow: false; }

.upgrade-blueprint {
  background: group(rect(#050E0A), border(-1, #315F45));
}

// The central equipment viewport gives the Matter Manipulator silhouette priority over its branches.
.upgrade-blueprint-focus {
  background: group(rect(#06110C), border(-1, #234B35));
}

.upgrade-manipulator-socket {
  background: group(rect(#07110D), border(-1, #6FB487));
}

.upgrade-branch-label { font-size: 5; text-color: #668474; text-shadow: false; }
.upgrade-branch-selected .upgrade-branch-label { text-color: #D0F2DA; }

.upgrade-node:host {
  base-background: group(rect(#07120D), border(-1, #355E45));
  hover-background: group(rect(#0D2B1C), border(-1, #74C58F));
  pressed-background: group(rect(#153E28), border(-1, #BDEBCB));
}

.upgrade-node .__button_text__ {
  font-size: 7;
  text-color: #5E7868;
  text-shadow: false;
}

.upgrade-node-locked:host { base-background: group(rect(#07100C), border(-1, #294636)); }
.upgrade-node-locked .__button_text__ { text-color: #405A4A; }

.upgrade-node-unlocked:host {
  base-background: group(rect(#123A24), border(-1, #58A771));
  hover-background: group(rect(#194D30), border(-1, #8FD1A3));
}
.upgrade-node-unlocked .__button_text__ { text-color: #B7DCC2; }

.upgrade-node-ready:host {
  base-background: group(rect(#29491C), border(-1, #B8F47A));
  hover-background: group(rect(#3A6227), border(-1, #E6FFB8));
}
.upgrade-node-ready .__button_text__ { text-color: #EAFACF; }

.upgrade-node-maxed:host {
  base-background: group(rect(#17502F), border(-1, #78C891));
  hover-background: group(rect(#21653C), border(-1, #BDE7C9));
}
.upgrade-node-maxed .__button_text__ { text-color: #D9F3E1; }

.upgrade-node-selected:host {
  base-background: group(rect(#112A1C), border(-1, #C8FFD8));
  hover-background: group(rect(#173C27), border(-1, #F0FFF4));
}
.upgrade-node-selected .__button_text__ { text-color: #F0FFF4; }

.upgrade-node-selected.upgrade-node-locked:host {
  base-background: group(rect(#0E2016), border(-1, #82B692));
}

.upgrade-node-selected.upgrade-node-unlocked:host {
  base-background: group(rect(#1B5433), border(-1, #B8E8C6));
}

.upgrade-node-selected.upgrade-node-ready:host {
  base-background: group(rect(#385B24), border(-1, #E8FFB9));
  hover-background: group(rect(#4C772E), border(-1, #FFFFFF));
}

.upgrade-node-selected.upgrade-node-maxed:host {
  base-background: group(rect(#246740), border(-1, #D7F8E0));
}

// Status strip returns to the ship-console palette; only the engineering accent remains green.
.upgrade-detail {
  background: group(rect(#0A1518), border(-1, #29443A));
}

.upgrade-detail-accent { background: #83E3A2; }
.upgrade-detail-top-line { background: #416B55; }
.upgrade-detail-bottom-line { background: #213A31; }
.upgrade-detail-name { font-size: 6; text-color: #D8EDF0; text-shadow: false; }
.upgrade-detail-level { font-size: 5; text-color: #789B86; text-shadow: false; }
.upgrade-detail-cost { font-size: 5; text-color: #E2B66F; text-shadow: false; }
.upgrade-detail-slot-label { font-size: 5; text-color: #71898C; text-shadow: false; }

.upgrade-main-action:host {
  base-background: group(rect(#1B5834), border(-1, #78C891));
  hover-background: group(rect(#277044), border(-1, #BDE7C9));
  pressed-background: group(rect(#104126), border(-1, #E5F8EA));
}

.upgrade-main-action .__button_text__ {
  font-size: 6;
  text-color: #EAF6ED;
  text-shadow: false;
}

.upgrade-main-action.__disabled__:host {
  base-background: group(rect(#10191A), border(-1, #324649));
  hover-background: group(rect(#10191A), border(-1, #324649));
  pressed-background: group(rect(#10191A), border(-1, #324649));
}

.upgrade-main-action.__disabled__ .__button_text__ { text-color: #52666A; }

// Player inventory stays intentionally neutral so it reads as Minecraft inventory, not part of the blueprint.
.upgrade-inventory-caption { font-size: 5; text-color: #7F9092; text-shadow: false; }
.upgrade-slot-socket { background: group(rect(#080C0D), border(-1, #3D494B)); }
.upgrade-player-socket { background: group(rect(#090E0F), border(-1, #3E4B4D)); }
.upgrade-hotbar-socket { background: group(rect(#0D1415), border(-1, #5B6C6E)); }
