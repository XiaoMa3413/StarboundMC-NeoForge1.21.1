// Matter Manipulator workbench: green engineering blueprint above an unchanged inventory.

.upgrade-screen { background: rect(#A605080A); }

.upgrade-shell {
  background: group(rect(#0B1113), border(-1, #56676A));
  overflow-clip: true;
}

.upgrade-blueprint-sheet {
  background: group(rect(#071A11), border(-1, #477F5D));
}

.upgrade-header {
  background: group(rect(#0A2418), border(-1, #315F45));
}

.upgrade-header-rail { background: #83E3A2; }

.upgrade-title { font-size: 6; text-color: #C8FFD8; text-shadow: false; }
.upgrade-header-hint { font-size: 5; text-color: #70A985; text-shadow: false; }
.upgrade-module-count { font-size: 5; text-color: #B8F47A; text-shadow: false; }

.upgrade-blueprint {
  background: group(rect(#06170F), border(-1, #3D7856));
}

.upgrade-manipulator-socket {
  background: group(rect(#06150E), border(-1, #7DD49A));
}

.upgrade-branch-label { font-size: 5; text-color: #73AC86; text-shadow: false; }
.upgrade-branch-selected .upgrade-branch-label { text-color: #C5FFD6; }

.upgrade-node:host {
  base-background: group(rect(#07170F), border(-1, #4A8B63));
  hover-background: group(rect(#103621), border(-1, #A0E9B7));
  pressed-background: group(rect(#1A5332), border(-1, #E1FFEA));
}

.upgrade-node .__button_text__ {
  font-size: 7;
  text-color: #639976;
  text-shadow: false;
}

.upgrade-node-locked:host { base-background: group(rect(#08150F), border(-1, #355E45)); }
.upgrade-node-locked .__button_text__ { text-color: #41684F; }

.upgrade-node-unlocked:host {
  base-background: group(rect(#1F7040), border(-1, #8CE5A8));
  hover-background: group(rect(#2D8B51), border(-1, #D4FFE0));
}
.upgrade-node-unlocked .__button_text__ { text-color: #E4FFEB; }

.upgrade-node-ready:host {
  base-background: group(rect(#4E7C27), border(-1, #B8F47A));
  hover-background: group(rect(#689B36), border(-1, #EAFFC4));
}
.upgrade-node-ready .__button_text__ { text-color: #F2FFD7; }

.upgrade-node-maxed:host {
  base-background: group(rect(#3B9960), border(-1, #C7FFDA));
  hover-background: group(rect(#52B574), border(-1, #FFFFFF));
}
.upgrade-node-maxed .__button_text__ { text-color: #FFFFFF; }

.upgrade-node-selected:host {
  base-background: group(rect(#174B2D), border(-1, #C8FFD8));
  hover-background: group(rect(#226A3D), border(-1, #F0FFF4));
}
.upgrade-node-selected .__button_text__ { text-color: #F0FFF4; }

.upgrade-node-selected.upgrade-node-locked:host {
  base-background: group(rect(#10271A), border(-1, #8BC79D));
}

.upgrade-node-selected.upgrade-node-unlocked:host {
  base-background: group(rect(#287F49), border(-1, #D0FFDD));
}

.upgrade-node-selected.upgrade-node-ready:host {
  base-background: group(rect(#557F2B), border(-1, #E9FFC0));
  hover-background: group(rect(#70A43C), border(-1, #FFFFFF));
}

.upgrade-node-selected.upgrade-node-maxed:host {
  base-background: group(rect(#46A669), border(-1, #E4FFEC));
}

.upgrade-detail {
  background: rect(#0B2619);
}

.upgrade-detail-accent { background: #82E7A2; }
.upgrade-detail-top-line { background: #4E9368; }
.upgrade-detail-bottom-line { background: #294D38; }
.upgrade-detail-name { font-size: 6; text-color: #D7FFE2; text-shadow: false; }
.upgrade-detail-level { font-size: 5; text-color: #80B792; text-shadow: false; }
.upgrade-detail-cost { font-size: 5; text-color: #B8F47A; text-shadow: false; }

.upgrade-main-action:host {
  base-background: group(rect(#1D6339), border(-1, #92E8AB));
  hover-background: group(rect(#2B804A), border(-1, #D0FFDD));
  pressed-background: group(rect(#104528), border(-1, #F0FFF4));
}

.upgrade-main-action .__button_text__ {
  font-size: 6;
  text-color: #F2FFF5;
  text-shadow: false;
}

.upgrade-main-action.__disabled__:host {
  base-background: group(rect(#102018), border(-1, #355542));
  hover-background: group(rect(#102018), border(-1, #355542));
  pressed-background: group(rect(#102018), border(-1, #355542));
}

.upgrade-main-action.__disabled__ .__button_text__ { text-color: #4A7258; }

// Player inventory intentionally keeps the existing neutral machine styling.
.upgrade-inventory-caption { font-size: 5; text-color: #7F9092; text-shadow: false; }
.upgrade-slot-socket { background: group(rect(#080C0D), border(-1, #3D494B)); }
.upgrade-player-socket { background: group(rect(#090E0F), border(-1, #3E4B4D)); }
.upgrade-hotbar-socket { background: group(rect(#0D1415), border(-1, #5B6C6E)); }
