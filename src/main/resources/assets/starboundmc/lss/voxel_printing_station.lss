// Voxel printer: shipboard matter fabrication, not a desktop management panel.
.machine-inventory-screen { background: rect(#A0050910); }
.voxel-printing-shell { background: group(rect(#091219), border(-1, #3B5963)); overflow-clip: true; }
.machine-inventory-header { background: group(rect(#0D1A22), border(-1, #29434E)); }
.voxel-printing-rail { background: #63E2DF; }
.machine-inventory-title { font-size: 9; text-color: #D8EDF0; text-shadow: false; }
.machine-status { font-size: 6; text-color: #7596A0; text-shadow: false; }
.voxel-printing-wallet { font-size: 7; text-color: #80DAD7; text-shadow: false; }
.voxel-printing-recipe-pane { background: rect(#0B151C); }
.voxel-printing-detail-pane { background: group(rect(#08141A), border(-1, #24444E)); }
.voxel-printing-queue-pane { background: rect(#0A141A); }
.voxel-pane-title, .machine-inventory-caption { font-size: 7; text-color: #88A6AF; text-shadow: false; }
.voxel-printing-category { background: group(rect(#0D1D24), border(-1, #35525C)); }
.voxel-category-dialog { background: group(rect(#09161D), border(-1, #476973)); }
.voxel-category-label { font-size: 7; text-color: #C9E0E4; text-shadow: false; }
.voxel-recipe-list .__scroller_view_vertical-scroller__, .voxel-print-queue-list .__scroller_view_vertical-scroller__ { width: 3; margin-left: 2; }
.voxel-recipe-list .__scroller_scroll_container__, .voxel-print-queue-list .__scroller_scroll_container__ { background: rect(#081116); padding-all: 0; }
.voxel-recipe-list .__scroller_scroll_bar__, .voxel-print-queue-list .__scroller_scroll_bar__ { base-background: built-in(ui-mc:SCROLLER_V) color(#42616A); hover-background: built-in(ui-mc:SCROLLER_V) color(#5E8A94); pressed-background: built-in(ui-mc:SCROLLER_V) color(#80C6C9); }
.voxel-recipe-row:host { base-background: rect(#0D1A20); hover-background: rect(#12272F); pressed-background: rect(#09151A); }
.voxel-recipe-rail { background: #24434C; }
.voxel-recipe-row.voxel-recipe-ready .voxel-recipe-rail { background: #397B7C; }
.voxel-recipe-row.voxel-recipe-unavailable:host { base-background: rect(#0A151A); hover-background: rect(#102127); }
.voxel-recipe-row.voxel-recipe-selected:host, .voxel-recipe-row.voxel-recipe-selected.voxel-recipe-unavailable:host { base-background: rect(#10252D); }
.voxel-recipe-selected .voxel-recipe-rail { background: #63E2DF; }
.voxel-recipe-name { font-size: 7; text-color: #CFE5E8; text-shadow: false; }
.voxel-recipe-amount { font-size: 6; text-color: #6F929C; text-shadow: false; }
.voxel-recipe-unavailable .voxel-recipe-name { text-color: #637C84; }
.voxel-recipe-selected .voxel-recipe-name { text-color: #E7FAFB; }
.voxel-recipe-empty, .voxel-queue-empty { font-size: 7; text-color: #607B84; text-shadow: false; }
.voxel-printing-detail-name { font-size: 8; text-color: #E6F5F6; text-shadow: false; }
.voxel-printing-detail-output, .voxel-printing-detail-meta { font-size: 6; text-color: #7899A3; text-shadow: false; }
.voxel-printing-detail-description { font-size: 6; text-color: #7899A3; text-shadow: false; }
.voxel-printing-output-socket { background: group(rect(#061014), border(-1, #4A8B91)); }
.voxel-fabrication-chamber { background: group(rect(#061419), border(-1, #2F6971)); }
.voxel-fabrication-preview { opacity: 0.92; }
.voxel-requirement-card { background: rect(#0C2026); }
.voxel-requirement-name { font-size: 5; text-color: #7898A1; text-shadow: false; }
.voxel-requirement-count { font-size: 6; text-color: #CDE7E9; text-shadow: false; }
.voxel-requirement-count.voxel-requirement-missing { text-color: #E2B66F; }
.voxel-printing-detail-status { font-size: 6; text-color: #86A4AD; text-shadow: false; }
.voxel-printing-detail-status.status-warning { text-color: #E2B66F; }
.voxel-printing-detail-status.status-success { text-color: #83E3A2; }
.voxel-printing-quantity { font-size: 6; text-color: #D9EEEF; text-shadow: false; background: rect(#071318); }
.voxel-printing-detail-pane .voxel-quantity-button .__button_text__ { font-size: 5; }
.voxel-quantity-button:host, .voxel-queue-cancel:host { base-background: group(rect(#14252B), border(-1, #3F5F68)); hover-background: group(rect(#1A343B), border(-1, #65949C)); pressed-background: group(rect(#0B1D22), border(-1, #9AD0D1)); }
.voxel-quantity-button .__button_text__, .voxel-queue-cancel .__button_text__ { font-size: 6; text-color: #CFE4E6; text-shadow: false; }
.voxel-printing-action:host { base-background: group(rect(#12373B), border(-1, #4DA3A4)); hover-background: group(rect(#195056), border(-1, #77D4D1)); pressed-background: group(rect(#0A292D), border(-1, #B4F0EC)); }
.voxel-printing-action .__button_text__ { font-size: 7; text-color: #E5FBFA; text-shadow: false; }
.voxel-printing-action.__disabled__:host, .voxel-quantity-button.__disabled__:host, .voxel-queue-cancel.__disabled__:host { base-background: group(rect(#101A1E), border(-1, #293A40)); hover-background: group(rect(#101A1E), border(-1, #293A40)); pressed-background: group(rect(#101A1E), border(-1, #293A40)); }
.__disabled__ .__button_text__ { text-color: #4E666E; }
.voxel-queue-row { background: rect(#0C1A20); overflow-clip: true; }
.voxel-queue-row.voxel-queue-row-active { background: group(rect(#10252C), border(-1, #3F8587)); }
.voxel-queue-row.queue-recent { background: group(rect(#10251F), border(-1, #5D9B79)); }
.voxel-queue-name { font-size: 7; text-color: #CFE5E7; text-shadow: false; }
.voxel-queue-state { font-size: 6; text-color: #7897A1; text-shadow: false; }
.voxel-queue-row-active .voxel-queue-state { text-color: #8EDDD9; }
.voxel-queue-requester { font-size: 5; text-color: #617E87; text-shadow: false; }
.voxel-queue-progress .__progress-bar_bar-container__ { background: rect(#061015); }
.voxel-queue-progress .__progress-bar_bar__ { background: rect(#63C9C9); }
.voxel-queue-cancel.__disabled__ .voxel-cancel-icon { opacity: 0.25; }
.machine-slot-socket { background: group(rect(#071015), border(-1, #344B54)); }
.player-slot-socket { background: group(rect(#081217), border(-1, #30434B)); }
.hotbar-slot-socket { background: group(rect(#0B171C), border(-1, #48616A)); }
